# Kopieer dit bestand naar .env en pas aan waar nodig:
#     cp .env.example .env
# Alles wat je weglaat krijgt de standaardwaarde.

# --- Veiligheid -------------------------------------------------------------
# Laat SECRET_KEY leeg: de applicatie maakt er zelf eenmalig een aan in
# instance/secret_key. Vul hem alleen in als je meerdere servers gebruikt.
#SECRET_KEY=

# Het account dat bij de allereerste start wordt aangemaakt.
GK_ADMIN_USER=admin
GK_ADMIN_PASSWORD=goldenknight

# Zet op true zodra het dashboard achter https draait.
GK_HTTPS=false
# Zet op true als er een reverse proxy (nginx/Caddy) voor staat.
GK_TRUST_PROXY=false

GK_SESSION_IDLE_MINUTES=240
GK_LOGIN_MAX_ATTEMPTS=5
GK_LOGIN_LOCKOUT_MINUTES=15

# --- Sensoren ---------------------------------------------------------------
# esp32     = de XIAO ESP32-C3 stuurt de metingen naar de Pi (standaard)
# auto      = eerst de ESP32, anders sensoren aan de Pi, anders simulatie
# hardware  = alleen sensoren die rechtstreeks aan de Pi hangen
# simulatie = altijd nepdata (handig om op een laptop te testen)
# extern    = de Pi haalt de data zelf op bij een andere service
GK_SENSOR_SOURCE=esp32

# Hoe lang een bericht van de ESP32 geldig blijft (seconden, minimaal 5).
# Komt er daarna niets meer binnen, dan meldt het dashboard dat de verbinding
# weg is in plaats van een oude waarde te blijven tonen.
GK_SENSOR_MAX_AGE=120

# Gedeeld wachtwoord dat de ESP32 meestuurt in de header X-Sensor-Token.
# Leeg = ieder apparaat op je netwerk mag metingen sturen. Vul hem in zodra
# het dashboard verder reikt dan je eigen netwerk, en zet dezelfde waarde in
# de Arduino-schets.
#GK_SENSOR_TOKEN=

# Alleen nodig bij GK_SENSOR_SOURCE=extern.
#GK_SENSOR_URL=http://127.0.0.1:8000/sensor

# Alleen nodig als er toch sensoren rechtstreeks aan de Pi hangen.
GK_DHT_PIN=4
GK_DHT_TYPE=DHT22
GK_I2C_BUS=1
GK_BH1750_ADDRESS=0x23

# Hoe vaak een meting wordt bewaard (seconden) en hoe lang (dagen, 0 = altijd).
GK_SAMPLE_INTERVAL=60
GK_HISTORY_DAYS=90

# Hoe vaak de browser de sensorwaarden ophaalt (milliseconden).
GK_REFRESH_MS=2000

# --- Weer -------------------------------------------------------------------
# Open-Meteo, gratis en zonder API-sleutel. Zoek je coördinaten op
# https://open-meteo.com/en/docs (of via een kaart).
GK_WEATHER_ENABLED=true
GK_WEATHER_PLACE=Amsterdam
GK_WEATHER_LAT=52.3676
GK_WEATHER_LON=4.9041
GK_WEATHER_CACHE_MINUTES=10

# --- Webserver --------------------------------------------------------------
GK_HOST=0.0.0.0
GK_PORT=5000
GK_DEBUG=false
